# OS junk
.DS_Store
Thumbs.db

# Local tooling (not used by this project, but harmless to ignore)
node_modules/
.vscode/
.idea/

# Always-on watcher runtime state (local to each deployment, never shared)
data/watcher-state.json
data/watcher-alerts.jsonl
# Web Push secrets: the VAPID signing key and the subscription store (capability
# URLs — whoever holds one can notify that device). Both stay on the watcher host.
data/vapid-keys.json
data/push-subscriptions.json
