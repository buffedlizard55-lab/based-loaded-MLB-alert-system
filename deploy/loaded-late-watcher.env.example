# Loaded Late watcher — environment template
#
# Copy to /etc/loaded-late/watcher.env (systemd), a .env next to
# deploy/docker-compose.yml (Docker), or ~/.loaded-late.env (launchd) and edit.
# Every variable is optional: with none of them set the watcher prints alerts to
# stdout and appends them to data/watcher-alerts.jsonl, and that is already a
# working always-on watch under journalctl / docker logs / tmux.
#
# This file is a template and must stay free of real values (see
# tools/watcher-deploy-test.mjs, which fails if a secret-looking value appears).

# ---- cadence -----------------------------------------------------------------
# Schedule discovery, in milliseconds (default 15000, clamped to 1000..600000).
WATCHER_POLL_MS=15000
# Snapshot cadence for a live game in inning 9+, in ms (default 2000).
WATCHER_LATE_MS=2000

# ---- where state and the alert log live --------------------------------------
# Keep this on disk that survives restarts: the state file is what stops a
# restart (or a cron run) from re-alerting a situation you already saw.
WATCHER_LOG_DIR=/var/lib/loaded-late

# Escape hatches, only needed if you want the two files somewhere unusual.
# Defaults: $WATCHER_LOG_DIR/watcher-alerts.jsonl and $WATCHER_LOG_DIR/watcher-state.json.
# WATCHER_LOG_FILE=
# WATCHER_STATE_FILE=

# ---- delivery: choose one, both, or neither ----------------------------------
# 1. Any HTTPS endpoint that accepts a JSON POST {"text": "...", "alert": {...}}.
#    Works with Slack/Discord-style incoming webhooks, ntfy, a serverless
#    function, or your own service. Leave empty to disable.
WATCHER_WEBHOOK_URL=
# 2. ntfy (phone app, no account needed): set the topic and install the app.
#    Treat the topic name as a password — anyone who knows it can read it.
WATCHER_NTFY_TOPIC=
#    ntfy server, if you self-host (default https://ntfy.sh).
WATCHER_NTFY_SERVER=https://ntfy.sh

# ---- noise -------------------------------------------------------------------
# 1 = no per-cycle "watched N games" heartbeat line (alerts are always printed).
WATCHER_QUIET=1
# Do NOT set WATCHER_ONCE=1 here: the service is meant to run continuously.
# It exists for cron/scheduled runs — see docs/watcher-deployment.md.
